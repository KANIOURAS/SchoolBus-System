
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/school_bus_tracking/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(PARENT)
  firstName     String?
  lastName      String?
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  children      Student[] @relation("ParentStudent")
  notifications Notification[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Bus {
  id              String   @id @default(cuid())
  name            String
  plateNumber     String   @unique
  capacity        Int
  imageUrl        String?
  status          BusStatus @default(ACTIVE)
  currentLat      Float?
  currentLng      Float?
  speed           Float    @default(0)
  isMoving        Boolean  @default(false)
  lastUpdate      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  driver          Driver?
  route           Route?
  students        Student[]
  gpsTracking     GPSTracking[]
  events          Event[]
  notifications   Notification[]
}

model Driver {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String   @unique
  phone       String
  licenseNumber String @unique
  experience  Int      // years
  rating      Float    @default(5.0)
  imageUrl    String?
  status      DriverStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  busId       String?  @unique
  bus         Bus?     @relation(fields: [busId], references: [id])
  events      Event[]
}

model Route {
  id          String   @id @default(cuid())
  name        String
  description String?
  startLat    Float
  startLng    Float
  endLat      Float
  endLng      Float
  distance    Float    // in km
  estimatedTime Int    // in minutes
  stops       Json     // array of stop coordinates and names
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  busId       String?  @unique
  bus         Bus?     @relation(fields: [busId], references: [id])
}

model Student {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  grade     String
  age       Int
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parentId  String
  parent    User     @relation("ParentStudent", fields: [parentId], references: [id])
  busId     String?
  bus       Bus?     @relation(fields: [busId], references: [id])
}

model GPSTracking {
  id        String   @id @default(cuid())
  lat       Float
  lng       Float
  speed     Float
  heading   Float?   // direction in degrees
  timestamp DateTime @default(now())

  busId     String
  bus       Bus      @relation(fields: [busId], references: [id])

  @@index([busId, timestamp])
}

model Event {
  id          String    @id @default(cuid())
  type        EventType
  severity    Severity  @default(MEDIUM)
  title       String
  description String?
  location    String?
  lat         Float?
  lng         Float?
  resolved    Boolean   @default(false)
  timestamp   DateTime  @default(now())

  busId       String
  bus         Bus       @relation(fields: [busId], references: [id])
  driverId    String?
  driver      Driver?   @relation(fields: [driverId], references: [id])
  notifications Notification[]
}

model Notification {
  id          String            @id @default(cuid())
  title       String
  message     String
  type        NotificationType
  severity    Severity          @default(MEDIUM)
  read        Boolean           @default(false)
  emailSent   Boolean           @default(false)
  timestamp   DateTime          @default(now())

  userId      String?
  user        User?             @relation(fields: [userId], references: [id])
  busId       String?
  bus         Bus?              @relation(fields: [busId], references: [id])
  eventId     String?
  event       Event?            @relation(fields: [eventId], references: [id])
}

enum UserRole {
  PARENT
  SCHOOL_ADMIN
}

enum BusStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  EMERGENCY
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum EventType {
  ACCIDENT
  SPEEDING
  SMOKING
  ALCOHOL
  DELAY
  BREAKDOWN
  EMERGENCY_STOP
  ROUTE_DEVIATION
}

enum NotificationType {
  SAFETY_ALERT
  LOCATION_UPDATE
  DELAY_NOTIFICATION
  EMERGENCY
  GENERAL
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
